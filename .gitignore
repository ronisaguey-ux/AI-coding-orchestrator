# Secrets — never commit
.env
.env.*
!*.env.example
orchestrator.env

# Python
__pycache__/
*.pyc
.venv/
venv/

# Orchestrator runtime state
orchestrator_data/
*.log
agent_todo_list.json
claude_*_inbox.json
