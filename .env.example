# Environment configuration template for AI Coding Orchestrator
# Copy to .env or load in your shell.

# Path overrides
# ORCH_CONFIG=/path/to/your/orch.yaml
# ORCH_REPO_DIR=/path/to/your/target/repo
# ORCH_BASE_DIR=/path/to/your/plans/dir

# Profile preset: default | max-throughput | low-memory | conservative | debug
# ORCH_PROFILE=default

# Provider Keys (Free / standard tiers)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_KEY_FILE=~/.claude/openrouter.token

# Local gateway endpoints (defaults to standard local ports)
# DEEPSEEK_GATEWAY_URL=http://127.0.0.1:8080/v1/chat/completions
# GEMINI_GATEWAY_URL=http://127.0.0.1:8085/v1/chat/completions
# OMNIROUTE_GATEWAY_URL=http://127.0.0.1:20128/v1/chat/completions
